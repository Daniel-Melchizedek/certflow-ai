@page "/"
@attribute [Authorize]
@using System.Net.Http.Json
@using System.Security.Claims
@inject IHttpClientFactory HttpFactory
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard — Certification Exam Portal</PageTitle>

<h1 class="pv-page-title">Dashboard</h1>

<div class="pv-dashboard">

    <!-- ── Upcoming appointments ─────────────────────────── -->
    <div class="pv-card">
        <div class="pv-card-header">View an upcoming test center appointment</div>
        <div class="pv-card-body">
            @if (loading)
            {
                <div class="pv-loading">
                    <div class="pv-skeleton" style="width:40%"></div>
                    <div class="pv-skeleton" style="width:70%"></div>
                    <div class="pv-skeleton" style="width:40%"></div>
                    <div class="pv-skeleton" style="width:65%"></div>
                </div>
            }
            else if (error is not null)
            {
                <div class="pv-alert pv-alert-error">@error</div>
            }
            else if (appointments.Length == 0)
            {
                <div class="pv-empty-state">
                    <p>You have no upcoming exam appointments.</p>
                    <p class="mt-2"><a href="/my-exams">View all exams</a></p>
                </div>
            }
            else
            {
                @foreach (var appt in appointments)
                {
                    <div class="pv-appt-entry">
                        <div class="pv-appt-date">@appt.StartLocal.ToString("dddd, MMMM d, yyyy")</div>
                        <div class="pv-appt-exam">
                            <a href="/my-exams/@appt.Id">@appt.ExamCode: @appt.ExamName</a>
                        </div>
                        <div class="pv-appt-meta">@appt.TestCenterName · @appt.TestCenterCity · @appt.StartLocal.ToString("h:mm tt") (@appt.IanaTimeZone)</div>
                    </div>
                }

                <div class="mt-3">
                    <a href="/my-exams" class="pv-btn pv-btn-primary pv-btn-sm">View all exams</a>
                </div>
            }
        </div>
    </div>

    <!-- ── My Account ────────────────────────────────────── -->
    <div class="pv-card">
        <div class="pv-card-header">My account</div>
        <ul class="pv-account-links">
            <li><a href="/my-exams">My upcoming exams</a></li>
            <li>
                @if (appointments.Length > 0)
                {
                    <a href="/my-exams/@appointments[0].Id/reschedule">Reschedule an exam</a>
                }
                else
                {
                    <a href="/my-exams">Reschedule an exam</a>
                }
            </li>
            <li><a href="/my-exams">Exam history</a></li>
            <li><a href="/MicrosoftIdentity/Account/SignOut">Sign out</a></li>
        </ul>
    </div>

</div>

@code {
    bool loading = true;
    string? error;
    AppointmentSummary[] appointments = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var oid = state.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
               ?? state.User.FindFirst("oid")?.Value;

        if (string.IsNullOrWhiteSpace(oid))
        {
            error = "Could not determine your identity. Please sign out and sign in again.";
            loading = false;
            return;
        }

        try
        {
            var client = HttpFactory.CreateClient("CertFlowApi");
            appointments = await client.GetFromJsonAsync<AppointmentSummary[]>(
                $"/api/appointments/my?entraUserId={Uri.EscapeDataString(oid)}") ?? [];
        }
        catch (Exception ex)
        {
            error = $"Could not load your appointments: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // StartLocal is resolved by the API against the test centre's own zone. Using StartUtc with
    // ToLocalTime() here would render the container's zone, which is UTC.
    record AppointmentSummary(Guid Id, string ExamCode, string ExamName, DateTimeOffset StartUtc,
        DateTime StartLocal, string IanaTimeZone,
        string TestCenterName, string TestCenterCity, string OrderNumber, string Status);
}
